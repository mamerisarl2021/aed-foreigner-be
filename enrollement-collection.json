{
  "info": {
    "name": "AED Foreigner Enrollment",
    "_postman_id": "7f6f5b9c-2b5f-4e7d-9a6f-3fa2a0d2e7d1",
    "description": "Parcours d'enrôlement étranger: OTP, init inscription, finalisation (ONLINE/IN_PERSON) avec création d'entreprise.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost" },
    { "key": "email", "value": "user@example.com" },
    { "key": "otp", "value": "" },
    { "key": "registration_token", "value": "" },
    { "key": "transaction_id", "value": "" }
  ],
  "item": [
    {
      "name": "1) Send OTP",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Structure OK', () => pm.expect(json).to.have.property('data').that.has.property('email'));",
              "// Conserver l'email utilisé (si modifié manuellement)\npm.collectionVariables.set('email', pm.variables.get('email'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/api/foreigner/send-otp", "host": ["{{base_url}}"], "path": ["api", "foreigner", "send-otp"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\"\n}"
        }
      }
    },
    {
      "name": "2) Verify OTP",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Email confirmé', () => pm.response.json().data.email);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/api/foreigner/verify-otp", "host": ["{{base_url}}"], "path": ["api", "foreigner", "verify-otp"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}"
        }
      }
    },
    {
      "name": "3) Init Registration",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Token présent', () => pm.expect(json.data).to.have.property('registration_token'));",
              "pm.collectionVariables.set('registration_token', json.data.registration_token);",
              "if (json.data.link) pm.collectionVariables.set('init_link', json.data.link);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": { "raw": "{{base_url}}/api/foreigner/register/init", "host": ["{{base_url}}"], "path": ["api", "foreigner", "register", "init"] },
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "email", "type": "text", "value": "{{email}}" },
            {
              "key": "profile",
              "type": "file",
              "src": ["C:\\\\path\\\\to\\\\profile.jpg"],
              "disabled": true
            }
          ]
        }
      }
    },
    {
      "name": "4) Finalize ONLINE (avec fichiers + entreprise)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('User créé', () => pm.expect(json.data).to.have.property('user_id'));",
              "pm.collectionVariables.set('user_id', json.data.user_id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": { "raw": "{{base_url}}/api/foreigner/register/finalize", "host": ["{{base_url}}"], "path": ["api", "foreigner", "register", "finalize"] },
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "registration_token", "type": "text", "value": "{{registration_token}}" },
            { "key": "transaction_id", "type": "text", "value": "{{transaction_id}}" },
            { "key": "type", "type": "text", "value": "ONLINE" },
            { "key": "level", "type": "text", "value": "ADVANCED" },
            { "key": "similarity", "type": "text", "value": "0.98" },
            { "key": "liveness", "type": "text", "value": "PASS" },
            { "key": "kyc[name]", "type": "text", "value": "DOE" },
            { "key": "kyc[first_name]", "type": "text", "value": "JOHN" },
            { "key": "kyc[phonenumber]", "type": "text", "value": "12345678" },
            { "key": "kyc[nationality]", "type": "text", "value": "FR" },
            { "key": "kyc[document_type]", "type": "text", "value": "PASSPORT" },
            { "key": "kyc[document_number]", "type": "text", "value": "P1234567" },
            { "key": "selfie", "type": "file", "src": ["C:\\\\path\\\\to\\\\selfie.jpg"] },
            { "key": "recto", "type": "file", "src": ["C:\\\\path\\\\to\\\\recto.jpg"] },
            { "key": "verso", "type": "file", "src": ["C:\\\\path\\\\to\\\\verso.jpg"] },
            { "key": "structure[name]", "type": "text", "value": "ACME" },
            { "key": "structure[ifu]", "type": "text", "value": "IFU-123" },
            { "key": "structure[attachements][0][name]", "type": "text", "value": "RCCM" },
            { "key": "structure[attachements][0][status]", "type": "text", "value": "SENT" },
            {
              "key": "structure[attachements][0][files][0]",
              "type": "file",
              "src": ["C:\\\\path\\\\to\\\\doc1.pdf"]
            }
          ]
        }
      }
    }
  ]
}