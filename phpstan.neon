includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    reportUnmatchedIgnoredErrors: true
    paths:
        - app/

    # Level 9 is the highest level. Level 9 ne demande plus que la traque
    # du `mixed` : ~500 erreurs, à ouvrir comme un chantier à part.
    level: 8
