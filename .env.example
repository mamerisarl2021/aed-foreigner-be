# .env.example — AED Foreigner Backend (copie → .env)
# Chaque variable est commentée. Valeurs = local sûr, secrets vides.
# Catalogue complet + flags [required]/[legacy]/[ci] : voir .env.schema
# php artisan key:generate après copie. Ne jamais committer .env

# -----------------------------------------------------------------------------
# Application — config/app.php, config/scramble.php, config/encryption.php
# -----------------------------------------------------------------------------

# Nom affiché (logs, mail, préfixes). Chaîne libre. Défaut Laravel: Laravel
APP_NAME=AED

# Environnement. Valeurs: local | staging | production | testing
APP_ENV=local

# [required][secret] php artisan key:generate → base64:...
APP_KEY=

# IV AES héritée (16 octets). Ne pas faire tourner. Défaut config: 4921a67c51de4c8b
ENCRYPTION_LEGACY_CBC_IV=

# Stack traces. Valeurs: true (local) | false (prod)
APP_DEBUG=true

# [required] URL publique backend, sans slash final
APP_URL=http://localhost:8000

# URL API publique. Vide = APP_URL. Ex: http://localhost:8000
API_URL=http://localhost:8000

# URL SPA (CORS, Sanctum, liens). Défaut code: http://localhost:3000
FRONTEND_URL=http://localhost:4200

# Redirection hors JSON si déjà authentifié. Défaut: /dashboard
APP_HOME=/dashboard

# Fuseau PHP. Ex: UTC | Africa/Porto-Novo | Europe/Paris
APP_TIMEZONE=UTC

# CDN assets. Vide = APP_URL
ASSET_URL=

# Version /docs/api. Défaut: 1.0.0
API_VERSION=1.0.0

# Mode maintenance. Valeurs: file | cache
APP_MAINTENANCE_DRIVER=file

# Store si driver=cache. Valeurs: database | redis | file | array
APP_MAINTENANCE_STORE=database

# -----------------------------------------------------------------------------
# Journalisation — config/logging.php
# -----------------------------------------------------------------------------

# Canal. Valeurs: stack | single | daily | slack | papertrail | stderr | syslog | errorlog | null
LOG_CHANNEL=stack

# Seuil. Valeurs: debug | info | notice | warning | error | critical | alert | emergency
LOG_LEVEL=debug

# Deprecations. Valeurs: null | single | daily | stderr
LOG_DEPRECATIONS_CHANNEL=null

# [secret] Webhook si LOG_CHANNEL=slack
LOG_SLACK_WEBHOOK_URL=

# Override handler Papertrail (FQCN) ou vide
LOG_PAPERTRAIL_HANDLER=

PAPERTRAIL_URL=
PAPERTRAIL_PORT=

# Formatter stderr (FQCN) ou vide
LOG_STDERR_FORMATTER=

# Canaux du driver stack, CSV
LOG_STACK=single

# Stack traces des deprecations. Valeurs: true | false
LOG_DEPRECATIONS_TRACE=false

# -----------------------------------------------------------------------------
# Base de données — config/database.php
# -----------------------------------------------------------------------------

# Connexion. Valeurs: mysql | sqlite | pgsql | sqlsrv

# URL unique (écrase DB_*). mysql://user:pass@host:3306/db ou vide
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# [secret] vide OK si root local sans mot de passe
DB_PASSWORD=

# Socket Unix MySQL ou vide
DB_SOCKET=

# Charset PDO. Défaut mysql: utf8mb4
DB_CHARSET=utf8mb4

# Collation MySQL
DB_COLLATION=utf8mb4_unicode_ci

# sqlite uniquement. Valeurs: true | false
DB_FOREIGN_KEYS=true

# CA SSL MySQL (PEM) ou vide
MYSQL_ATTR_SSL_CA=

# -----------------------------------------------------------------------------
# Cache & session
# CACHE_STORE lu en premier ; CACHE_DRIVER = alias Laravel 10
# Local: file. Tests: array. Redis: redis (+ REDIS_*)
# -----------------------------------------------------------------------------

# Valeurs: file | database | redis | array | memcached | dynamodb | octane | apc | null
CACHE_STORE=file
CACHE_DRIVER=file

# Préfixe clés. Vide = {slug APP_NAME}_cache_
CACHE_PREFIX=

MEMCACHED_PERSISTENT_ID=
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

DYNAMODB_CACHE_TABLE=cache
DYNAMODB_ENDPOINT=

# Session. Valeurs: file | cookie | database | redis | array | memcached | dynamodb | apc
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_CONNECTION=
SESSION_STORE=
SESSION_COOKIE=
SESSION_DOMAIN=

# Cookie Secure. true | false | vide (Secure si HTTPS)
SESSION_SECURE_COOKIE=

# Chiffrer le payload session. Valeurs: true | false
SESSION_ENCRYPT=false

# Table si SESSION_DRIVER=database
SESSION_TABLE=sessions

# Path du cookie
SESSION_PATH=/

# Cookie HttpOnly. Valeurs: true | false
SESSION_HTTP_ONLY=true

# SameSite. Valeurs: lax | strict | none
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Fichiers — config/filesystems.php
# -----------------------------------------------------------------------------

# Disque. Valeurs: local | public | s3
FILESYSTEM_DISK=local

# [secret] S3 / SES / SQS / DynamoDB — vides si disque local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=

# MinIO: http://127.0.0.1:9000 et AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Queue & broadcast
# -----------------------------------------------------------------------------

# Jobs. Valeurs: sync | database | redis | sqs | beanstalkd | null
QUEUE_CONNECTION=sync

# Jobs en échec. Valeurs: database-uuids | dynamodb | file | null
QUEUE_FAILED_DRIVER=database-uuids

SQS_PREFIX=
SQS_QUEUE=default
SQS_SUFFIX=

# Broadcast. Valeurs: log | null | pusher | ably | redis
BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log

PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_ID=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
ABLY_KEY=

# -----------------------------------------------------------------------------
# Redis — phpredis (extension) ou predis (composer)
# Redis avec requirepass: mot de passe réel, pas la chaîne "null"
# -----------------------------------------------------------------------------

# Valeurs: phpredis | predis
REDIS_CLIENT=predis

# Valeurs: redis | predis
REDIS_CLUSTER=redis

REDIS_PREFIX=
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=

# [secret] vide si pas d'auth
REDIS_PASSWORD=

REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PERSISTENT=false
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000
REDIS_QUEUE=default
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=90

# -----------------------------------------------------------------------------
# Mail — local: log (pas d'SMTP). Tests: array
# -----------------------------------------------------------------------------

# Valeurs: smtp | sendmail | mailgun | ses | ses-v2 | postmark | log | array | failover | roundrobin
MAIL_MAILER=log
MAIL_URL=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525

# Schéma SMTP Laravel 12. Valeurs: smtp | smtps | vide
MAIL_SCHEME=

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_LOG_CHANNEL=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
RESEND_API_KEY=
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# Coût bcrypt. 4–16. Tests: 4. Défaut app: 12
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Sanctum / CORS
# -----------------------------------------------------------------------------

# CSV hôtes SPA. Vide = localhost + hôtes APP_URL et FRONTEND_URL
SANCTUM_STATEFUL_DOMAINS=

# Durée Bearer minutes. Défaut: 720
SANCTUM_TOKEN_EXPIRATION_MINUTES=720

# CSV origines exactes. Vide = FRONTEND_URL. Jamais *
CORS_ALLOWED_ORIGINS=

VIEW_COMPILED_PATH=

# Audit Owen-it. Valeurs: true | false
AUDITING_ENABLED=true

# -----------------------------------------------------------------------------
# KYC Regula — local: mock
# -----------------------------------------------------------------------------

# true = MockRegulaService | false = Document Reader + Face
REGULA_MOCK=true
REGULA_DOCUMENT_URL=
REGULA_FACE_URL=
REGULA_URL=
REGULA_API_KEY=
REGULA_TIMEOUT=60
REGULA_DOCUMENT_SCENARIO=FullProcess
REGULA_MATCH_THRESHOLD=0.75

# -----------------------------------------------------------------------------
# TrustedX / ANIP / horodatage
# -----------------------------------------------------------------------------

TX_BASE_URL=
TX_CLIENT_ID=
TX_CLIENT_SECRET=
TX_ADMINS_LOGGED_AS=
TX_CLIENTS_LOGGED_AS=
TX_SCOPE=urn:gob:basic:profile
TX_REDIRECT_URL=http://localhost:4200/etranger/connexion/callback
TX_REDIRECT_PATH=/etranger/connexion/callback
TX_ALLOWED_REDIRECT_URLS=

# true = log password/PIN/token. Jamais true en prod
TRUSTEDX_LOG_CALLS=false
TRUSTEDX_VERIFY_SSL=true
TRUSTEDX_TIMEOUT=15

ANIP_BASE_URL=
ANIP_USERNAME=
ANIP_PASSWORD=
TIMESTAMP_API_URL=
TIMESTAMP_API_USERNAME=
TIMESTAMP_API_PASSWORD=

# -----------------------------------------------------------------------------
# Consul + JWT guest (passerelle)
# Local sans gateway: KEYCLOAK_ENABLED=false
# -----------------------------------------------------------------------------

CONSUL_URL=http://localhost:8500
CONSUL_SCHEME=http
CONSUL_HOST=localhost
CONSUL_PORT=8500
CONSUL_HTTP_TOKEN=
CONSUL_CACERT=
CONSUL_HTTP_TIMEOUT=10
CONSUL_SERVICE_NAME=portal-id-foreigner
CONSUL_SERVICE_IP=127.0.0.1
CONSUL_SERVICE_PORT=8000
CONSUL_HEALTH_PATH=/api/v1/health
CONSUL_CHECK_INTERVAL=10s
CONSUL_CHECK_TIMEOUT=2s
CONSUL_DEREGISTER_CRITICAL_AFTER=1m

# true = JWT guest obligatoire | false = local sans passerelle
KEYCLOAK_ENABLED=false
KEYCLOAK_LOG_CALLS=false

KC_INFRA_TOKEN_URI=
KC_INFRA_JWKS=
KC_INFRA_ISSUER=
KC_INFRA_AUDIENCE=
KC_INFRA_CLIENT_ID=
KC_INFRA_SECRET=
CONSUL_ACL_AUTH_METHOD=keycloak-infra-svc

# Staff pki-portal — ne pas copier KC_INFRA_* ici
KC_STAFF_JWKS=
KC_STAFF_ISSUER=
KC_STAFF_AUDIENCE=backoffice-stranger
KC_STAFF_CLIENT_ID=backoffice-stranger
KC_STAFF_SCOPE="openid profile email"

# -----------------------------------------------------------------------------
# Notifications + Kafka
# Local: NOTIFICATION_DRIVER=log (pas besoin de broker)
# -----------------------------------------------------------------------------

# Valeurs: kafka | log | null
NOTIFICATION_DRIVER=log
NOTIFICATION_PLATFORM=PORTAL

# false = OTP en clair dans laravel.log (local debug uniquement)
NOTIFICATION_REDACT_SECRETS=true

KAFKA_BROKERS=localhost:9092

# Valeurs: PLAINTEXT | SASL_PLAINTEXT | SASL_SSL | SSL
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# SASL: PLAIN | PLAINTEXT | SCRAM-SHA-256 | SCRAM-SHA-512
KAFKA_MECHANISMS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SSL_CA_LOCATION=
KAFKA_SSL_CERT_LOCATION=
KAFKA_SSL_KEY_LOCATION=
KAFKA_SSL_ENDPOINT_IDENTIFICATION_ALGORITHM=

KAFKA_CONSUMER_GROUP_ID=group
KAFKA_CONSUMER_DEFAULT_TIMEOUT=2000

# Valeurs: latest | earliest | none
KAFKA_OFFSET_RESET=latest
KAFKA_AUTO_COMMIT=true
KAFKA_ERROR_SLEEP=5
KAFKA_PARTITION=0

# Valeurs: none | gzip | lz4 | snappy
KAFKA_COMPRESSION_TYPE=snappy
KAFKA_DEBUG=false
KAFKA_CACHE_DRIVER=
MESSAGE_ID_KEY=laravel-kafka::message-id

KAFKA_TOPIC_EMAIL=notify.email
KAFKA_TOPIC_SMS=notify.sms
KAFKA_TOPIC_WEBSOCKET=notify.websocket

# Événements d'enrôlement. Valeurs driver: kafka | log | null (défaut = NOTIFICATION_DRIVER)
ENROLLMENT_EVENTS_DRIVER=
KAFKA_TOPIC_OTP_SEND=enrolement.otp.send
KAFKA_TOPIC_ENROLEMENT_CREATED=enrolement.created
KAFKA_TOPIC_ENROLEMENT_STATUS_CHANGED=enrolement.status_changed
KAFKA_TOPIC_ENROLEMENT_APPROVED=enrolement.approved
KAFKA_TOPIC_ENROLEMENT_REJECTED=enrolement.rejected
KAFKA_TOPIC_ENROLEMENT_COMPLETED=enrolement.completed

ENROLLMENT_SLA_MAX_HOURS=72
ENROLLMENT_SIMILARITY_CACHE_TTL_SECONDS=120
ENROLLMENT_MORALE_EMAIL_VERIFICATION_HOURS=24
ENROLLMENT_MORALE_PHONE_OTP_TTL_MINUTES=5
ENROLLMENT_MORALE_CORRECTION_DAYS=7
ENROLLMENT_MORALE_CORRECTION_REMINDER_HOURS=24

# -----------------------------------------------------------------------------
# PHPUnit / packages optionnels (déjà forcé dans phpunit.xml)
# -----------------------------------------------------------------------------

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false

# -----------------------------------------------------------------------------
# testkafka.sh (pas Laravel)
# -----------------------------------------------------------------------------

KAFKA_CONTAINER=kafka1
KAFKA_BIN=/opt/kafka/bin
KAFKA_BOOTSTRAP_INTERNAL=kafka1:29092

# GitLab CI seulement (service postgres:18), pas le .env applicatif :
# POSTGRES_DB=  POSTGRES_USER=  POSTGRES_PASSWORD=  FF_NETWORK_PER_BUILD=true
