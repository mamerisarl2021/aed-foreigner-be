# .env.schema — AED Foreigner Backend
#
# Catalogue de toutes les variables d'environnement lues par ce dépôt
# (config/*.php, phpunit.xml, .gitlab-ci.yml, testkafka.sh).
#
# Ne jamais y coller de vrais secrets. Copier .env.example → .env et remplir.
# Le code applicatif lit via config() — pas env() hors config/.
#
# Légende:
#   [required]  indispensable pour démarrer dans cet environnement
#   [secret]    sensible — vault / CI en production
#   [local]     valeur recommandée en local uniquement
#   [legacy]    encore lue, mais héritée / à ne pas étendre
#   [ci]        pipeline GitLab / PHPUnit uniquement
#
# Booléens Laravel: true | false (aussi 1 | 0 | yes | no).
# Listes: valeurs séparées par des virgules, sans espaces superflus.

# =============================================================================
# Application — config/app.php, config/scramble.php, config/encryption.php
# =============================================================================

APP_NAME=                    # Nom affiché (logs, mail, préfixes cache/session/redis). Chaîne libre. Défaut: Laravel
APP_ENV=                     # Environnement. Valeurs: local | staging | production | testing. Défaut: production
APP_KEY=                     # [required][secret] Clé de chiffrement Laravel. Format: base64:... via php artisan key:generate. Jamais vide en prod
ENCRYPTION_LEGACY_CBC_IV=    # IV AES-256-CBC des fichiers chiffrés avant le préfixe d'IV aléatoire. 16 octets. Défaut: 4921a67c51de4c8b. Ne pas faire tourner
APP_DEBUG=                   # Stack traces. Valeurs: true (local) | false (production, testing). Défaut: false
APP_URL=                     # [required] URL publique du backend (sans slash final). Ex: http://localhost:8000 | https://api.example.org
API_URL=                     # URL publique de l'API. Défaut: APP_URL. Ex: http://localhost:8000
FRONTEND_URL=                # URL du SPA (CORS, Sanctum, liens e-mail). Défaut: http://localhost:3000. Ex: http://localhost:4200
APP_HOME=                    # Chemin de redirection si déjà authentifié (hors JSON). Défaut: /dashboard
APP_TIMEZONE=                # Fuseau PHP. Ex: UTC | Africa/Porto-Novo | Europe/Paris. Défaut: UTC
ASSET_URL=                   # CDN / préfixe des assets. Vide = APP_URL. URL ou vide
API_VERSION=                 # Version affichée dans /docs/api (Scramble). Défaut: 1.0.0. Ex: 1.0.0
APP_MAINTENANCE_DRIVER=      # Driver mode maintenance. Valeurs: file | cache. Défaut: file. PHPUnit: file
APP_MAINTENANCE_STORE=       # Store cache si APP_MAINTENANCE_DRIVER=cache. Valeurs: database | redis | file | array. Défaut: database

# =============================================================================
# Journalisation — config/logging.php
# =============================================================================

LOG_CHANNEL=                 # Canal par défaut. Valeurs: stack | single | daily | slack | papertrail | stderr | syslog | errorlog | null. Défaut: stack
LOG_LEVEL=                   # Seuil Monolog. Valeurs: debug | info | notice | warning | error | critical | alert | emergency. Défaut: debug. Prod: info ou error
LOG_DEPRECATIONS_CHANNEL=    # Canal des deprecations. Valeurs: null | single | daily | stderr. Défaut: null
LOG_SLACK_WEBHOOK_URL=       # [secret] Webhook Slack si LOG_CHANNEL=slack. URL https://hooks.slack.com/... ou vide
LOG_PAPERTRAIL_HANDLER=      # Classe handler Papertrail. Défaut: Monolog\Handler\SyslogUdpHandler. Laisser vide sauf override
PAPERTRAIL_URL=              # Hôte Papertrail si canal papertrail. Hostname ou vide
PAPERTRAIL_PORT=             # Port Papertrail. Entier. Ex: 12345
LOG_STDERR_FORMATTER=        # Formatter Monolog pour stderr. Classe FQCN ou vide
LOG_STACK=                   # Canaux du driver stack, CSV. Défaut: single
LOG_DEPRECATIONS_TRACE=      # Stack traces des deprecations. Valeurs: true | false. Défaut: false

# =============================================================================
# Base de données — config/database.php
# =============================================================================

DB_CONNECTION=               # [required] Connexion PDO. Valeurs: mysql (prod/tests) | sqlite | pgsql | sqlsrv. Défaut: mysql
DB_URL=                      # URL unique (écrase DB_HOST/DB_DATABASE/…). mysql://user:pass@host:3306/db ou vide
DB_HOST=                     # [required si pas DB_URL] Hôte. Ex: 127.0.0.1 | mysql (CI) | hostname
DB_PORT=                     # Port. mysql: 3306 | pgsql: 5432 | sqlsrv: 1433. Défaut mysql: 3306
DB_DATABASE=                 # [required] Nom de la base (ou chemin .sqlite). Ex: aed_foreigner | my_database (CI)
DB_USERNAME=                 # [required mysql] Utilisateur. Ex: root
DB_PASSWORD=                 # [required][secret] Mot de passe. Chaîne, peut être vide en local root sans mot de passe
DB_SOCKET=                   # Socket Unix MySQL. Chemin ou vide
DB_CHARSET=                  # Charset PDO. Défaut mysql: utf8mb4. pgsql/sqlsrv: utf8
DB_COLLATION=                # Collation MySQL. Défaut: utf8mb4_unicode_ci
DB_FOREIGN_KEYS=             # Contraintes FK sqlite. Valeurs: true | false. Défaut: true
MYSQL_ATTR_SSL_CA=           # Chemin du CA SSL MySQL. Fichier PEM ou vide

# Tests: .env.testing ou phpunit.xml. Ne jamais committer DB_USERNAME/DB_PASSWORD dans phpunit.xml.

# =============================================================================
# Cache & session — config/cache.php, config/session.php
# =============================================================================
# CACHE_STORE est lu en premier; CACHE_DRIVER est l'alias Laravel 10 (même effet).
# Local: file (évite Spatie Permission si la table cache n'existe pas encore).
# Tests/CI: array.

CACHE_STORE=                 # Store cache. Valeurs: file | database | redis | array | memcached | dynamodb | octane | apc | null. Local: file. Tests: array
CACHE_DRIVER=                # Alias de CACHE_STORE (Laravel 10). Mêmes valeurs. Ignoré si CACHE_STORE est défini
CACHE_PREFIX=                # Préfixe des clés. Défaut: {slug APP_NAME}_cache_. Chaîne ou vide

MEMCACHED_PERSISTENT_ID=     # ID persistant Memcached. Chaîne ou vide
MEMCACHED_USERNAME=          # [secret] SASL Memcached. Chaîne ou vide
MEMCACHED_PASSWORD=          # [secret] SASL Memcached. Chaîne ou vide
MEMCACHED_HOST=              # Hôte Memcached. Défaut: 127.0.0.1
MEMCACHED_PORT=              # Port Memcached. Défaut: 11211

DYNAMODB_CACHE_TABLE=        # Table DynamoDB cache. Défaut: cache
DYNAMODB_ENDPOINT=           # Endpoint DynamoDB local. URL ou vide

SESSION_DRIVER=              # Driver session. Valeurs: file | cookie | database | redis | array | memcached | dynamodb | apc. Local: file. Tests: array. API Sanctum: file ou array suffisent
SESSION_LIFETIME=            # Durée d'idle en minutes. Entier. Défaut: 120
SESSION_CONNECTION=          # Connexion DB/redis pour sessions. Nom de connexion database.php ou vide (défaut)
SESSION_STORE=               # Store cache pour sessions redis/memcached/dynamodb. Nom d'un store cache.php ou vide
SESSION_COOKIE=              # Nom du cookie. Défaut: {slug APP_NAME}_session
SESSION_DOMAIN=              # Domaine du cookie. Ex: .example.org | localhost | vide (hôte courant)
SESSION_SECURE_COOKIE=       # Cookie Secure. Valeurs: true | false | vide (Secure seulement en HTTPS). Prod HTTPS: true
SESSION_ENCRYPT=             # Chiffrer le payload session. Valeurs: true | false. Défaut: false
SESSION_TABLE=               # Table si SESSION_DRIVER=database. Défaut: sessions
SESSION_PATH=                # Path du cookie. Défaut: /
SESSION_HTTP_ONLY=           # Cookie HttpOnly. Valeurs: true | false. Défaut: true
SESSION_SAME_SITE=           # SameSite. Valeurs: lax | strict | none. Défaut: lax

# =============================================================================
# Files & objets — config/filesystems.php
# =============================================================================

FILESYSTEM_DISK=             # Disque par défaut. Valeurs: local | public | s3. Défaut: local
AWS_ACCESS_KEY_ID=           # [secret] Clé S3 / SES / SQS / DynamoDB. Chaîne ou vide si disque local
AWS_SECRET_ACCESS_KEY=       # [secret] Secret S3 / SES / SQS. Chaîne ou vide
AWS_DEFAULT_REGION=          # Région AWS. Ex: us-east-1 | eu-west-1. Défaut SES: us-east-1
AWS_BUCKET=                  # Bucket S3. Nom ou vide
AWS_URL=                     # URL publique du bucket. URL ou vide
AWS_ENDPOINT=                # Endpoint S3-compatible (MinIO). Ex: http://127.0.0.1:9000 ou vide
AWS_USE_PATH_STYLE_ENDPOINT= # Path-style (MinIO). Valeurs: true | false. Défaut: false. MinIO: true

# =============================================================================
# Queue & broadcast — config/queue.php, config/broadcasting.php
# =============================================================================

QUEUE_CONNECTION=            # Backend jobs Laravel. Valeurs: sync | database | redis | sqs | beanstalkd | null. Local/tests: sync. Prod jobs: database ou redis
QUEUE_FAILED_DRIVER=         # Stockage jobs en échec. Valeurs: database-uuids | dynamodb | file | null. Défaut: database-uuids
SQS_PREFIX=                  # Préfixe URL SQS. URL AWS
SQS_QUEUE=                   # Nom de file SQS. Défaut: default
SQS_SUFFIX=                  # Suffixe SQS. Chaîne ou vide

BROADCAST_CONNECTION=        # Broadcaster Laravel 11+. Valeurs: log | null | pusher | ably | redis. Défaut via BROADCAST_DRIVER: null. Tests: null
BROADCAST_DRIVER=            # Alias de BROADCAST_CONNECTION. Mêmes valeurs. Local: log
PUSHER_APP_KEY=              # [secret] Pusher. Chaîne ou vide
PUSHER_APP_SECRET=           # [secret] Pusher. Chaîne ou vide
PUSHER_APP_ID=               # ID app Pusher. Chaîne ou vide
PUSHER_APP_CLUSTER=          # Cluster Pusher. Ex: mt1 | eu | ap1
PUSHER_HOST=                 # Hôte Pusher custom. Hostname ou vide (api-{cluster}.pusher.com)
PUSHER_PORT=                 # Port Pusher. Défaut: 443
PUSHER_SCHEME=               # Schéma Pusher. Valeurs: https | http. Défaut: https
ABLY_KEY=                    # [secret] Clé Ably. Chaîne ou vide

# =============================================================================
# Redis — config/database.php (cache, queue, sessions, broadcast)
# =============================================================================
# Client: phpredis (extension) ou predis (composer require predis/predis).
# Redis local avec requirepass: renseigner REDIS_PASSWORD (pas "null").

REDIS_CLIENT=                # Client PHP. Valeurs: phpredis | predis. Défaut: phpredis
REDIS_CLUSTER=               # Mode cluster. Valeurs: redis | predis. Défaut: redis
REDIS_PREFIX=                # Préfixe clés. Défaut: {slug APP_NAME}_database_
REDIS_URL=                   # URL redis://[:password@]host:port/db — écrase HOST/PORT/PASSWORD si défini
REDIS_HOST=                  # Hôte. Défaut: 127.0.0.1
REDIS_USERNAME=              # ACL Redis 6+. Chaîne ou vide
REDIS_PASSWORD=              # [secret] Mot de passe. Vide si pas d'auth. Ne pas mettre la chaîne "null" si Redis exige un mot de passe
REDIS_PORT=                  # Port. Défaut: 6379
REDIS_DB=                    # Index DB connexion default (queues). Entier 0–15. Défaut: 0
REDIS_CACHE_DB=              # Index DB connexion cache. Entier, distinct de REDIS_DB. Défaut: 1
REDIS_PERSISTENT=            # Connexions persistantes. Valeurs: true | false. Défaut: false
REDIS_MAX_RETRIES=           # Tentatives client Redis. Entier. Défaut: 3
REDIS_BACKOFF_ALGORITHM=     # Algo backoff. Défaut: decorrelated_jitter
REDIS_BACKOFF_BASE=          # Base backoff ms. Entier. Défaut: 100
REDIS_BACKOFF_CAP=           # Plafond backoff ms. Entier. Défaut: 1000
REDIS_QUEUE=                 # Nom de file si QUEUE_CONNECTION=redis. Défaut: default
REDIS_QUEUE_CONNECTION=      # Connexion Redis des jobs. Défaut: default
REDIS_QUEUE_RETRY_AFTER=     # retry_after jobs Redis, secondes. Entier. Défaut: 90

# =============================================================================
# Mail — config/mail.php, config/services.php (mailgun/resend/ses)
# Notifications métier: Kafka (NOTIFICATION_DRIVER), pas Mail::
# =============================================================================

MAIL_MAILER=                 # Transport. Valeurs: smtp | sendmail | mailgun | ses | ses-v2 | postmark | log | array | failover | roundrobin. Local: log. Tests: array
MAIL_URL=                    # URL SMTP unique. smtp://user:pass@host:587 ou vide
MAIL_HOST=                   # Hôte SMTP. Défaut: smtp.mailgun.org. Local log: 127.0.0.1
MAIL_PORT=                   # Port SMTP. 25 | 465 | 587 | 2525. Défaut: 587
MAIL_SCHEME=                 # Schéma SMTP Laravel 12. Valeurs: smtp | smtps | vide
MAIL_USERNAME=               # [secret] SMTP. Chaîne ou vide
MAIL_PASSWORD=               # [secret] SMTP. Chaîne ou vide
MAIL_EHLO_DOMAIN=            # Domaine EHLO/HELO. Hostname ou vide
MAIL_SENDMAIL_PATH=          # Binaire sendmail. Défaut: /usr/sbin/sendmail -bs -i
MAIL_LOG_CHANNEL=            # Canal si MAIL_MAILER=log. Nom de canal logging.php ou vide
MAIL_FROM_ADDRESS=           # Expéditeur. E-mail. Défaut: hello@example.com
MAIL_FROM_NAME=              # Nom expéditeur. Chaîne. Défaut: Example. Souvent "${APP_NAME}"
MAILGUN_DOMAIN=              # Domaine Mailgun. Chaîne ou vide
MAILGUN_SECRET=              # [secret] Clé Mailgun. Chaîne ou vide
MAILGUN_ENDPOINT=            # API Mailgun. Défaut: api.mailgun.net
RESEND_API_KEY=              # [secret] Clé Resend. Chaîne ou vide
SLACK_BOT_USER_OAUTH_TOKEN=  # [secret] Slack notifications Laravel. xoxb-... ou vide
SLACK_BOT_USER_DEFAULT_CHANNEL= # Canal Slack. Ex: #alerts ou vide

# =============================================================================
# Hachage — config/hashing.php
# =============================================================================

BCRYPT_ROUNDS=               # Coût bcrypt. Entier 4–16. Défaut: 12. Tests/PHPUnit: 4

# =============================================================================
# Sanctum / CORS — config/sanctum.php, config/cors.php
# =============================================================================

SANCTUM_STATEFUL_DOMAINS=    # Hôtes SPA cookies Sanctum. CSV. Défaut: localhost,127.0.0.1 + hôtes APP_URL et FRONTEND_URL
SANCTUM_TOKEN_EXPIRATION_MINUTES= # Durée Bearer Sanctum en minutes. Entier. Défaut: 720 (12 h)
CORS_ALLOWED_ORIGINS=        # Origines CORS. CSV d'origines exactes. Défaut: FRONTEND_URL. Jamais * avec credentials

# =============================================================================
# Vues — config/view.php
# =============================================================================

VIEW_COMPILED_PATH=          # Dossier des vues Blade compilées. Chemin ou vide (storage/framework/views)

# =============================================================================
# Audit — config/audit.php
# =============================================================================

AUDITING_ENABLED=            # Owen-it auditing. Valeurs: true | false. Défaut: true

# =============================================================================
# KYC Regula — config/services.php regula.*
# =============================================================================

REGULA_MOCK=                 # Mock KYC. Valeurs: true (local/CI, MockRegulaService) | false (Document Reader + Face). Défaut: false
REGULA_DOCUMENT_URL=         # [required si REGULA_MOCK=false] Base Document Reader. Ex: http://127.0.0.1:8080
REGULA_FACE_URL=             # [required si REGULA_MOCK=false] Base Face API. Ex: http://127.0.0.1:41101
REGULA_URL=                  # [legacy] Fallback si DOCUMENT_URL ou FACE_URL vide. Même forme d'URL
REGULA_API_KEY=              # [secret] Bearer optionnel (démo/proxy). Vide pour licence on-prem
REGULA_TIMEOUT=              # Timeout HTTP secondes. Entier. Défaut: 60
REGULA_DOCUMENT_SCENARIO=    # Scénario Document Reader. Défaut: FullProcess. Voir doc Regula
REGULA_MATCH_THRESHOLD=      # Similarité Face 0.0–1.0. Float. Défaut: 0.75. En dessous: KYC en échec

# =============================================================================
# TrustedX / PKI / ANIP / horodatage — config/trustedx.php
# AuthTrait hérité lit encore env() directement [legacy]
# =============================================================================

TX_BASE_URL=                 # [required client login] Hôte TrustedX sans https://. Ex: pki.example.org
TX_CLIENT_ID=                # Client OAuth TrustedX (public dans GET /configuration). Ne pas confondre avec TX_CLIENT_SECRET
TX_CLIENT_SECRET=            # [secret] Secret OAuth TrustedX — jamais exposé par GET /configuration
TX_ADMINS_LOGGED_AS=         # Identifiant domaine admin TrustedX. Chaîne fournie par l'opérateur PKI
TX_CLIENTS_LOGGED_AS=        # Identifiant domaine client TrustedX
TX_SCOPE=                    # Scope authorize TrustedX. Défaut: urn:gob:basic:profile → config('trustedx.scope')
TX_REDIRECT_URL=             # Redirect URI d'échange de code (doit matcher /authorize). Ex: http://localhost:4200/etranger/connexion/callback
TX_REDIRECT_PATH=            # Path SPA pour /authorize. Vide = path de TX_REDIRECT_URL. Ex: /etranger/connexion/callback
TX_ALLOWED_REDIRECT_URLS=    # Redirect URIs extra (CSV), ajoutés à TX_REDIRECT_URL. URLs ou vide
TRUSTEDX_LOG_CALLS=          # Log INFO de chaque appel TrustedX (password/PIN/token). Valeurs: true | false. Défaut: false. Jamais true en prod
TRUSTEDX_VERIFY_SSL=         # Vérif TLS TrustedX. Valeurs: true | false. Défaut: true. Jamais false en prod
TRUSTEDX_TIMEOUT=            # Timeout HTTP secondes. Entier. Défaut: 15
ANIP_BASE_URL=               # Base ANIP. URL ou vide
ANIP_USERNAME=               # [secret] Basic Auth ANIP
ANIP_PASSWORD=               # [secret] Basic Auth ANIP
TIMESTAMP_API_URL=           # URL autorité d'horodatage
TIMESTAMP_API_USERNAME=      # [secret] User horodatage
TIMESTAMP_API_PASSWORD=      # [secret] Mot de passe horodatage

# =============================================================================
# Consul + JWT guest (passerelle) — config/consul.php
# KEYCLOAK_ENABLED = JWT infra sur routes guest, pas le login staff
# =============================================================================

CONSUL_URL=                  # URL de base Consul. Défaut: http://localhost:8500
CONSUL_SCHEME=               # Schéma. Valeurs: http | https. Défaut: http
CONSUL_HOST=                 # Hôte. Défaut: localhost
CONSUL_PORT=                 # Port. Défaut: 8500
CONSUL_HTTP_TOKEN=           # [secret] ACL Consul. Token ou vide
CONSUL_CACERT=               # CA TLS Consul. Chemin PEM ou vide
CONSUL_HTTP_TIMEOUT=         # Timeout HTTP secondes. Entier. Défaut: 10
CONSUL_SERVICE_NAME=         # Nom enregistré. Défaut: portal-id-foreigner
CONSUL_SERVICE_IP=           # IP annoncée. IPv4. Défaut: résolution du hostname
CONSUL_SERVICE_PORT=         # Port annoncé. Défaut: 8000
CONSUL_HEALTH_PATH=          # Chemin health check. Défaut: /api/v1/health
CONSUL_CHECK_INTERVAL=       # Intervalle check Consul. Ex: 10s. Défaut: 10s
CONSUL_CHECK_TIMEOUT=        # Timeout check. Ex: 2s. Défaut: 2s
CONSUL_DEREGISTER_CRITICAL_AFTER= # Délai avant deregister. Ex: 1m. Défaut: 1m

KEYCLOAK_ENABLED=            # JWT passerelle sur routes guest (OTP, KYC, dépôt, suivi, finalisation). Valeurs: true (défaut, fail-closed) | false (local sans gateway)
KEYCLOAK_LOG_CALLS=          # Log HTTP Keycloak/Consul (sans secrets). Valeurs: true | false. Défaut: false
KC_INFRA_TOKEN_URI=          # Token endpoint realm infra (ACL Consul). URL
KC_INFRA_JWKS=               # JWKS realm infra. URL …/protocol/openid-connect/certs
KC_INFRA_ISSUER=             # Issuer realm infra. URL …/realms/…
KC_INFRA_AUDIENCE=           # Audience JWT infra
KC_INFRA_CLIENT_ID=          # Client OAuth infra
KC_INFRA_SECRET=             # [secret] Secret client infra
CONSUL_ACL_AUTH_METHOD=      # Méthode ACL Consul. Défaut: keycloak-infra-svc

# =============================================================================
# Staff Keycloak (realm pki-portal) — config/keycloak.php
# Indépendant de KEYCLOAK_ENABLED. POST /admin/login/keycloak.
# Ne jamais pointer KC_STAFF_* sur KC_INFRA_* (realm différent).
# =============================================================================

KC_STAFF_JWKS=               # [required staff] JWKS pki-portal. URL …/realms/pki-portal/protocol/openid-connect/certs
KC_STAFF_ISSUER=             # [required staff] Issuer pki-portal. URL …/realms/pki-portal
KC_STAFF_AUDIENCE=           # Audience JWT. Défaut: backoffice-stranger
KC_STAFF_CLIENT_ID=          # Client resource_access. Défaut: backoffice-stranger
KC_STAFF_SCOPE=              # Scope authorize staff. Défaut: openid profile email → config('keycloak.staff.scope')

# =============================================================================
# Notifications Kafka — config/notifications.php, config/kafka.php
# =============================================================================

NOTIFICATION_DRIVER=         # Publisher e-mail/SMS/WS. Valeurs: kafka | log | null. Défaut: kafka. Local: log. Tests: souvent log ou null
NOTIFICATION_PLATFORM=       # Champ platform des payloads. Défaut: PORTAL
NOTIFICATION_REDACT_SECRETS= # Masque OTP/mots de passe dans le driver log. Valeurs: true | false. Défaut: true. false = local debug OTP uniquement

KAFKA_BROKERS=               # Bootstrap brokers. Défaut: localhost:9092. Ex: kafka1:29092 | broker:9092
KAFKA_SECURITY_PROTOCOL=     # Protocole. Valeurs: PLAINTEXT | SASL_PLAINTEXT | SASL_SSL | SSL. Défaut: PLAINTEXT
KAFKA_MECHANISMS=            # Mécanisme SASL. Valeurs: PLAIN | PLAINTEXT | SCRAM-SHA-256 | SCRAM-SHA-512. Défaut package: PLAINTEXT
KAFKA_USERNAME=              # [secret] SASL. Chaîne ou vide
KAFKA_PASSWORD=              # [secret] SASL. Chaîne ou vide
KAFKA_SSL_CA_LOCATION=       # CA PEM si SSL. Chemin ou vide
KAFKA_SSL_CERT_LOCATION=     # Cert client PEM. Chemin ou vide
KAFKA_SSL_KEY_LOCATION=      # Clé client PEM. Chemin ou vide
KAFKA_SSL_ENDPOINT_IDENTIFICATION_ALGORITHM= # Vérif hostname TLS. Ex: https | vide
KAFKA_CONSUMER_GROUP_ID=     # Group id (package; ce backend ne consomme pas). Défaut: group
KAFKA_CONSUMER_DEFAULT_TIMEOUT= # Timeout consumer ms. Entier. Défaut: 2000
KAFKA_OFFSET_RESET=          # auto.offset.reset. Valeurs: latest | earliest | none. Défaut: latest
KAFKA_AUTO_COMMIT=           # enable.auto.commit. Valeurs: true | false. Défaut: true
KAFKA_ERROR_SLEEP=           # Sleep secondes sur erreur. Entier. Défaut: 5
KAFKA_PARTITION=             # Partition producteur. Entier. Défaut: 0
KAFKA_COMPRESSION_TYPE=      # Codec. Valeurs: none | gzip | lz4 | snappy. Défaut: snappy
KAFKA_DEBUG=                 # Debug client Kafka. Valeurs: true | false. Défaut: false
KAFKA_CACHE_DRIVER=          # Cache du package kafka. Valeurs: comme CACHE_STORE. Défaut: CACHE_STORE puis file
MESSAGE_ID_KEY=              # Clé d'id de message Kafka. Défaut: laravel-kafka::message-id

KAFKA_TOPIC_EMAIL=           # Topic e-mails. Défaut: notify.email
KAFKA_TOPIC_SMS=             # Topic SMS. Défaut: notify.sms
KAFKA_TOPIC_WEBSOCKET=       # Topic websocket. Défaut: notify.websocket

# =============================================================================
# Événements d'enrôlement — config/enrollment_events.php, config/enrollment.php
# =============================================================================

ENROLLMENT_EVENTS_DRIVER=    # Publisher événements domaine. Valeurs: kafka | log | null. Défaut: NOTIFICATION_DRIVER puis log
KAFKA_TOPIC_OTP_SEND=        # Défaut: enrolement.otp.send
KAFKA_TOPIC_ENROLEMENT_CREATED= # Défaut: enrolement.created
KAFKA_TOPIC_ENROLEMENT_STATUS_CHANGED= # Défaut: enrolement.status_changed
KAFKA_TOPIC_ENROLEMENT_APPROVED= # Défaut: enrolement.approved
KAFKA_TOPIC_ENROLEMENT_REJECTED= # Défaut: enrolement.rejected
KAFKA_TOPIC_ENROLEMENT_COMPLETED= # Défaut: enrolement.completed

ENROLLMENT_SLA_MAX_HOURS=    # SLA instruction en heures. Entier. Défaut: 72
ENROLLMENT_MORALE_EMAIL_VERIFICATION_HOURS= # Validité lien e-mail morale. Entier. Défaut: 24
ENROLLMENT_MORALE_PHONE_OTP_TTL_MINUTES=    # TTL OTP téléphone morale. Entier. Défaut: 5
ENROLLMENT_MORALE_CORRECTION_DAYS=          # Délai A_CORRIGER après REJET_CONFIRME. Entier. Défaut: 7
ENROLLMENT_MORALE_CORRECTION_REMINDER_HOURS= # Relance avant échéance. Entier. Défaut: 24

# =============================================================================
# PHPUnit / packages optionnels (phpunit.xml) — [ci]
# =============================================================================

PULSE_ENABLED=               # Laravel Pulse. Valeurs: true | false. PHPUnit: false. Package non requis ici
TELESCOPE_ENABLED=           # Laravel Telescope. Valeurs: true | false. PHPUnit: false. Package non requis ici
NIGHTWATCH_ENABLED=          # Laravel Nightwatch. Valeurs: true | false. PHPUnit: false. Package non requis ici

# =============================================================================
# GitLab CI service MySQL — .gitlab-ci.yml — [ci] (pas lues par Laravel)
# =============================================================================

MYSQL_ROOT_PASSWORD=         # [ci][secret] Mot de passe root du service mysql:8.0
MYSQL_DATABASE=              # [ci] Base créée dans le service. Ex: my_database
FF_NETWORK_PER_BUILD=        # [ci] Flag GitLab Runner. Valeurs: true | false

# =============================================================================
# testkafka.sh — [local] pas lues par Laravel
# =============================================================================

KAFKA_CONTAINER=             # Nom du conteneur Docker Kafka. Défaut script: kafka1
KAFKA_BIN=                   # Chemin des binaires dans le conteneur. Défaut: /opt/kafka/bin
KAFKA_BOOTSTRAP_INTERNAL=    # Listener interne. Défaut: kafka1:29092

