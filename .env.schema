# .env.schema — AED Foreigner Backend
#
# Reference for developers and AI tooling. Do NOT commit real secrets.
# Copy `.env.example` → `.env` and fill values locally.
# Application code must read values via config() — never env() outside config/.
#
# Legend:
#   [required]  Must be set for the app to run in that environment
#   [secret]    Sensitive — use vault/CI secrets in production
#   [local]     Recommended value for local development only

# =============================================================================
# Application (config/app.php)
# =============================================================================

APP_NAME=                    # [required] Application display name. Default: Laravel
APP_ENV=                     # [required] local | staging | production | testing
APP_KEY=                     # [required][secret] php artisan key:generate
APP_DEBUG=                   # [required] true (local) | false (production)
APP_URL=                     # [required] Backend public URL → config('app.url')
APP_HOME=                    # Dashboard path after login. Default: /dashboard
APP_TIMEZONE=                # Default: UTC → config('app.timezone')

API_URL=                     # Public API base URL → config('app.api_url')
FRONTEND_URL=                # SPA / front-office URL → config('app.frontend_url')

# =============================================================================
# Logging (config/logging.php)
# =============================================================================

LOG_CHANNEL=                 # Default: stack
LOG_STACK=                   # Default: single
LOG_LEVEL=                   # debug (local) | info | error (production)
LOG_DEPRECATIONS_CHANNEL=    # Default: null
LOG_DEPRECATIONS_TRACE=      # Default: false

# =============================================================================
# Database (config/database.php) — [required] for MySQL deployments
# =============================================================================

DB_CONNECTION=               # [required] mysql (production) | sqlite (minimal local)
DB_HOST=                     # [required] MySQL host
DB_PORT=                     # Default: 3306
DB_DATABASE=                 # [required] Database name
DB_USERNAME=                 # [required] Database user
DB_PASSWORD=                 # [required][secret] Database password
DB_URL=                      # Optional single connection URL (overrides DB_* when set)
DB_SOCKET=                   # Optional Unix socket
DB_CHARSET=                  # Default: utf8mb4
DB_COLLATION=                # Default: utf8mb4_unicode_ci

# Testing: use `.env.testing` or phpunit.xml overrides (separate test database recommended)

# =============================================================================
# Cache & session (config/cache.php, config/session.php)
# =============================================================================
# P0 note: defaults in config/ use `database` driver but no cache/sessions migrations
# exist. For fresh local installs use file drivers (see .env.example).

CACHE_STORE=                 # [required local] file | database | redis. Local: file
CACHE_PREFIX=                # Auto-derived from APP_NAME if unset

SESSION_DRIVER=              # [required local] file | database | redis. Local: file
SESSION_LIFETIME=            # Minutes. Default: 120
SESSION_ENCRYPT=             # Default: false
SESSION_PATH=                # Default: /
SESSION_DOMAIN=              # Optional cookie domain

# Only if CACHE_STORE=database:
DB_CACHE_TABLE=              # Default: cache

# Only if SESSION_DRIVER=database:
SESSION_TABLE=               # Default: sessions

# =============================================================================
# Queue & broadcast (config/queue.php, config/broadcasting.php)
# =============================================================================

QUEUE_CONNECTION=            # sync (local/tests) | database | redis
BROADCAST_DRIVER=            # log | null | pusher

# =============================================================================
# Filesystem / object storage (config/filesystems.php)
# =============================================================================

FILESYSTEM_DISK=             # local | public | s3 | minio
FILESYSTEM_CLOUD=            # Cloud disk for uploads (e.g. minio, s3)

MINIO_ACCESS_KEY_ID=         # [secret] When using MinIO
MINIO_SECRET_ACCESS_KEY=     # [secret]
MINIO_DEFAULT_REGION=        # e.g. us-east-1
MINIO_BUCKET=
MINIO_URL=
MINIO_ENDPOINT=
MINIO_USE_PATH_STYLE_ENDPOINT=  # true for MinIO

AWS_ACCESS_KEY_ID=           # [secret] When using S3
AWS_SECRET_ACCESS_KEY=       # [secret]
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=

# =============================================================================
# Mail (config/mail.php) — legacy; notifications prefer Kafka
# =============================================================================

MAIL_MAILER=                 # smtp | log | array
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=               # [secret]
MAIL_PASSWORD=               # [secret]
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# =============================================================================
# Redis (optional — cache, queue, sessions)
# =============================================================================

REDIS_HOST=                  # Default: 127.0.0.1
REDIS_PASSWORD=              # [secret]
REDIS_PORT=                  # Default: 6379

# =============================================================================
# Sanctum / CORS
# =============================================================================

SANCTUM_STATEFUL_DOMAINS=    # Comma-separated; defaults include APP_URL and FRONTEND_URL hosts

# =============================================================================
# Payment — Kkiapay (config/kkiapay.php)
# =============================================================================
# Legacy structure/subscription billing was removed. KKIA_* remains for a future
# foreigner payment flow if product defines one.

KKIA_PUBLIC_KEY=             # [secret] → config('kkiapay.public_key')
KKIA_PRIVATE_KEY=            # [secret] → config('kkiapay.private_key')
KKIA_SECRET_KEY=             # [secret] → config('kkiapay.secret')
KKIA_SANDBOX=                # true | false → config('kkiapay.sandbox'). Default: true

# =============================================================================
# TrustedX / PKI (config/trustedx.php)
# =============================================================================

TX_BASE_URL=                 # → config('trustedx.base_url')
TX_CLIENT_ID=                # [secret] → config('trustedx.client_id')
TX_CLIENT_SECRET=            # [secret] → config('trustedx.client_secret')
TX_ADMINS_LOGGED_AS=         # → config('trustedx.admins_logged_as')
TX_CLIENTS_LOGGED_AS=        # → config('trustedx.clients_logged_as')
TX_REDIRECT_URL=             # → config('trustedx.redirect_url')
ANIP_BASE_URL=               # → config('trustedx.anip_base_url')

TIMESTAMP_API_URL=           # → config('trustedx.timestamp.url')
TIMESTAMP_API_USERNAME=      # [secret] → config('trustedx.timestamp.username')
TIMESTAMP_API_PASSWORD=      # [secret] → config('trustedx.timestamp.password')

# =============================================================================
# SMS — Twilio
# =============================================================================

TWILIO_SID=                  # [secret]
TWILIO_TOKEN=                # [secret]
TWILIO_FROM=                 # Sender number

# =============================================================================
# LDAP / directory
# =============================================================================

LDAP_HOSTS=
LDAP_PORT=
LDAP_USE_SSL=
LDAP_USE_TLS=
LDAP_BASE_DN=
LDAP_USERNAME=               # [secret]
LDAP_PASSWORD=               # [secret]
LDAP_LOGGING=

LDAP_API_URL=
LDAP_API_USERNAME=           # [secret]
LDAP_API_PASSWORD=           # [secret]

# =============================================================================
# Timestamp authority
# =============================================================================

TIMESTAMP_API_URL=
TIMESTAMP_API_USERNAME=      # [secret]
TIMESTAMP_API_PASSWORD=      # [secret]

# =============================================================================
# Consul service discovery (config/consul.php)
# =============================================================================

CONSUL_HOST=                 # Default: localhost
CONSUL_PORT=                 # Default: 8500
CONSUL_SCHEME=               # http | https
CONSUL_URL=                  # Full base URL
CONSUL_HTTP_TOKEN=           # [secret] ACL token when Consul secured
CONSUL_CACERT=               # Path to CA cert for HTTPS

CONSUL_SERVICE_NAME=         # Default: portal-id-foreigner
CONSUL_SERVICE_IP=           # Registered service IP
CONSUL_SERVICE_PORT=         # Registered service port (e.g. 8000)
CONSUL_HEALTH_PATH=          # Default: /api/v1/health

KC_INFRA_TOKEN_URI=          # Keycloak token endpoint for Consul ACL
KC_INFRA_JWKS=
KC_INFRA_ISSUER=
KC_INFRA_AUDIENCE=
KC_INFRA_CLIENT_ID=
KC_INFRA_SECRET=             # [secret]
CONSUL_ACL_AUTH_METHOD=      # Default: keycloak-infra-svc
KEYCLOAK_ENABLED=            # false (local) | true (production gateway path)
GATEWAY_URL=                 # Platform API gateway base URL for Bruno/frontends

# =============================================================================
# Kafka notifications (config/kafka.php, config/notifications.php)
# =============================================================================

KAFKA_BROKERS=               # Default: localhost:9092
KAFKA_SECURITY_PROTOCOL=     # PLAINTEXT | SASL_SSL | SSL
KAFKA_MECHANISMS=
KAFKA_USERNAME=              # [secret] When SASL enabled
KAFKA_PASSWORD=              # [secret]

KAFKA_SSL_CA_LOCATION=
KAFKA_SSL_CERT_LOCATION=
KAFKA_SSL_KEY_LOCATION=
KAFKA_SSL_ENDPOINT_IDENTIFICATION_ALGORITHM=

KAFKA_TOPIC_EMAIL=           # Default: notify.email → config('notifications.topics.email')
KAFKA_TOPIC_SMS=             # Default: notify.sms
KAFKA_TOPIC_WEBSOCKET=       # Default: notify.websocket
NOTIFICATION_PLATFORM=       # Default: PORTAL

# Notification delivery driver (config/notifications.php)
#   kafka — publish to Kafka (production / integrated environments)
#   log   — write payloads to storage/logs/laravel.log (local dev)
#   null  — no-op (tests or when notifications are intentionally disabled)
NOTIFICATION_DRIVER=         # Default: kafka → config('notifications.driver')

# Enrollment domain events (config/enrollment_events.php)
ENROLLMENT_EVENTS_DRIVER=    # log | null | kafka — mirrors NOTIFICATION_DRIVER in local dev
KAFKA_TOPIC_OTP_SEND=        # Default: enrolement.otp.send
KAFKA_TOPIC_ENROLEMENT_CREATED=
KAFKA_TOPIC_ENROLEMENT_STATUS_CHANGED=
KAFKA_TOPIC_ENROLEMENT_APPROVED=
KAFKA_TOPIC_ENROLEMENT_REJECTED=
KAFKA_TOPIC_ENROLEMENT_COMPLETED=

# =============================================================================
# Auditing (config/audit.php)
# =============================================================================

AUDITING_ENABLED=            # Default: true

# =============================================================================
# Auditing (config/audit.php) — requires `audits` migration
# =============================================================================
# `user_id` is UUID (matches users.id). `auditable_id` is string to support
# both UUID users and bigint identities.

# =============================================================================
# Database seeding (config/seeding.php) — local/dev defaults
# =============================================================================

SEED_ADMIN_NAME=             # Default: Admin → config('seeding.admin.name')
SEED_ADMIN_EMAIL=            # Default: admin@example.com → config('seeding.admin.email')
SEED_ADMIN_PASSWORD=         # [secret][local] Default in config for local only → config('seeding.admin.password')

# =============================================================================
# PHPUnit / local testing (phpunit.xml or .env.testing)
# =============================================================================
# Recommended .env.testing overrides:
#   APP_ENV=testing
#   CACHE_STORE=array
#   QUEUE_CONNECTION=sync
#   SESSION_DRIVER=array
#   DB_DATABASE=<dedicated_test_database>

# =============================================================================
# Variables previously used via env() in app/ — now use config() (P1 complete)
# =============================================================================
# config('app.frontend_url')  ← FRONTEND_URL
# config('app.url')          ← APP_URL
# config('app.timezone')      ← APP_TIMEZONE
# config('trustedx.*')        ← TX_* / ANIP_* / TIMESTAMP_*
# config('kkiapay.*')         ← KKIA_*
