{
  "info": {
    "name": "AED - Identity Review (2 niveaux)",
    "_postman_id": "5a5d3c1a-6a4a-4f3f-9f2a-2d0c3b2a9c11",
    "description": "Parcours d’examen d’identités: liste, détail, claim, approbation agent, approbation/rejet superviseur.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost" },
    { "key": "agent_token", "value": "" },
    { "key": "supervisor_token", "value": "" },
    { "key": "identity_id", "value": "" },
    { "key": "identity_id_supervised", "value": "" }
  ],
  "item": [
    {
      "name": "1) List - PENDING non assignées (agent)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "const items = (json.data && json.data.data) ? json.data.data : [];",
              "if (items.length) {",
              "  pm.collectionVariables.set('identity_id', items[0].id);",
              "}",
              "pm.test('Liste OK', () => Array.isArray(items));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{agent_token}}", "type": "string" } ] },
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/management/identity-reviews?status=PENDING&assigned=false&per_page=10&order_by=id&order_dir=desc",
          "host": [ "{{base_url}}" ],
          "path": [ "api", "management", "identity-reviews" ],
          "query": [
            { "key": "status", "value": "PENDING" },
            { "key": "assigned", "value": "false" },
            { "key": "per_page", "value": "10" },
            { "key": "order_by", "value": "id" },
            { "key": "order_dir", "value": "desc" }
          ]
        }
      }
    },
    {
      "name": "2) Claim (agent)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.collectionVariables.get('identity_id')) {",
              "  postman.setNextRequest(null);",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        { "listen": "test", "script": { "exec": [ "pm.test('200', () => pm.response.to.have.status(200));" ], "type": "text/javascript" } }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{agent_token}}", "type": "string" } ] },
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/api/management/identity-reviews/{{identity_id}}/claim",
          "host": [ "{{base_url}}" ],
          "path": [ "api", "management", "identity-reviews", "{{identity_id}}", "claim" ]
        }
      }
    },
    {
      "name": "3) Show - Détail (agent)",
      "request": {
        "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{agent_token}}", "type": "string" } ] },
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/management/identity-reviews/{{identity_id}}",
          "host": [ "{{base_url}}" ],
          "path": [ "api", "management", "identity-reviews", "{{identity_id}}" ]
        }
      },
      "event": [
        { "listen": "test", "script": { "exec": [ "pm.test('200', () => pm.response.to.have.status(200));" ], "type": "text/javascript" } }
      ]
    },
    {
      "name": "4) Approve (agent) → statut APPROVED_BY_AGENT",
      "request": {
        "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{agent_token}}", "type": "string" } ] },
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/api/management/identity-reviews/{{identity_id}}/approve",
          "host": [ "{{base_url}}" ],
          "path": [ "api", "management", "identity-reviews", "{{identity_id}}", "approve" ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "if (json && json.data && json.data.identity_id) {",
              "  pm.collectionVariables.set('identity_id_supervised', json.data.identity_id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5) List - APPROVED_BY_AGENT (superviseur)",
      "request": {
        "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{supervisor_token}}", "type": "string" } ] },
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/management/identity-reviews?status=APPROVED_BY_AGENT&assigned=true&per_page=10",
          "host": [ "{{base_url}}" ],
          "path": [ "api", "management", "identity-reviews" ],
          "query": [
            { "key": "status", "value": "APPROVED_BY_AGENT" },
            { "key": "assigned", "value": "true" },
            { "key": "per_page", "value": "10" }
          ]
        }
      },
      "event": [
        { "listen": "test", "script": { "exec": [ "pm.test('200', () => pm.response.to.have.status(200));" ], "type": "text/javascript" } }
      ]
    },
    {
      "name": "6) Supervisor Approve → statut APPROVED + Welcome",
      "request": {
        "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{supervisor_token}}", "type": "string" } ] },
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/api/management/identity-reviews/{{identity_id_supervised}}/supervisor/approve",
          "host": [ "{{base_url}}" ],
          "path": [ "api", "management", "identity-reviews", "{{identity_id_supervised}}", "supervisor", "approve" ]
        }
      },
      "event": [
        { "listen": "test", "script": { "exec": [ "pm.test('200', () => pm.response.to.have.status(200));" ], "type": "text/javascript" } }
      ]
    },
    {
      "name": "7) Reject (agent) – KYC ou STRUCTURE",
      "request": {
        "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{agent_token}}", "type": "string" } ] },
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": {
          "raw": "{{base_url}}/api/management/identity-reviews/{{identity_id}}/reject",
          "host": [ "{{base_url}}" ],
          "path": [ "api", "management", "identity-reviews", "{{identity_id}}", "reject" ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"stage\": \"KYC\",\n  \"reasons\": [\"Selfie non conforme\", \"Similarité insuffisante\"],\n  \"comments\": \"Veuillez reprendre le selfie avec bonne luminosité.\"\n}"
        }
      },
      "event": [
        { "listen": "test", "script": { "exec": [ "pm.test('200', () => pm.response.to.have.status(200));" ], "type": "text/javascript" } }
      ]
    },
    {
      "name": "8) Supervisor Reject – après APPROVED_BY_AGENT",
      "request": {
        "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{supervisor_token}}", "type": "string" } ] },
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "url": {
          "raw": "{{base_url}}/api/management/identity-reviews/{{identity_id_supervised}}/supervisor/reject",
          "host": [ "{{base_url}}" ],
          "path": [ "api", "management", "identity-reviews", "{{identity_id_supervised}}", "supervisor", "reject" ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"stage\": \"STRUCTURE\",\n  \"reasons\": [\"Pièce manquante\", \"IFU invalide\"],\n  \"comments\": \"Ajoutez le justificatif RCCM valide.\"\n}"
        }
      },
      "event": [
        { "listen": "test", "script": { "exec": [ "pm.test('200', () => pm.response.to.have.status(200));" ], "type": "text/javascript" } }
      ]
    },
    {
      "name": "9) List - Filtres avancés (recherche/période)",
      "request": {
        "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{agent_token}}", "type": "string" } ] },
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/management/identity-reviews?status=PENDING,REJECTED&type=ONLINE&level=ADVANCED&q=gmail.com&from=2025-09-01&to=2025-09-30&order_by=created_at&order_dir=asc&per_page=5",
          "host": [ "{{base_url}}" ],
          "path": [ "api", "management", "identity-reviews" ],
          "query": [
            { "key": "status", "value": "PENDING,REJECTED" },
            { "key": "type", "value": "ONLINE" },
            { "key": "level", "value": "ADVANCED" },
            { "key": "q", "value": "gmail.com" },
            { "key": "from", "value": "2025-09-01" },
            { "key": "to", "value": "2025-09-30" },
            { "key": "order_by", "value": "created_at" },
            { "key": "order_dir", "value": "asc" },
            { "key": "per_page", "value": "5" }
          ]
        }
      },
      "event": [
        { "listen": "test", "script": { "exec": [ "pm.test('200', () => pm.response.to.have.status(200));" ], "type": "text/javascript" } }
      ]
    }
  ]
}