meta {
  name: 4A) Finalize ONLINE (avec fichiers + entreprise)
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/foreigner/register/finalize
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  registration_token: {{registration_token}}
  transaction_id: {{transaction_id}}
  type: ONLINE
  level: ADVANCED
  similarity: 0.98
  liveness: PASS
  kyc[name]: DOE
  kyc[first_name]: JOHN
  kyc[phonenumber]: 12345678
  kyc[nationality]: FR
  kyc[document_type]: PASSPORT
  kyc[document_number]: P1234567
  selfie: @file(C:\\path\\to\\selfie.jpg)
  recto: @file(C:\\path\\to\\recto.jpg)
  verso: @file(C:\\path\\to\\verso.jpg)
  structure[name]: ACME
  structure[ifu]: IFU-123
  structure[attachements][0][name]: RCCM
  structure[attachements][0][status]: SENT
  structure[attachements][0][files][0]: @file(C:\\path\\to\\doc1.pdf)
}

script:post-response {
  test('Status 200', () => expect(res.getStatus()).to.equal(200));
  const json = res.getBody();
  test('User créé', () => expect(json.data).to.have.property('user_id'));
  bru.setVar('user_id', json.data.user_id);
}

settings {
  encodeUrl: true
}
