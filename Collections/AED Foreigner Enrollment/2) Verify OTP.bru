meta {
  name: 2) Verify OTP
  type: http
  seq: 2
}

post {
  url: {{gateway_url}}/api/v1/otp/verify
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{keycloak_token}}
}

body:json {
  {
    "email": "{{email}}",
    "otp": "{{otp_email}}"
  }
}

script:post-response {
  test('Status 200', () => expect(res.getStatus()).to.equal(200));
}
