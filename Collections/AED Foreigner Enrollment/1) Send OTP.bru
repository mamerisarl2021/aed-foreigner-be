meta {
  name: 1) Send OTP
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/foreigner/send-otp
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}"
  }
}

script:post-response {
  test('Status 200', () => expect(res.getStatus()).to.equal(200));
  const json = res.getBody();
  test('Structure OK', () => expect(json).to.have.property('data').that.has.property('email'));
  // Conserver l'email utilisé (si modifié manuellement)
  bru.setVar('email', bru.getVar('email'));
}
