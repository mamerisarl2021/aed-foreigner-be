meta {
  name: 1) Send OTP
  type: http
  seq: 1
}

post {
  url: {{gateway_url}}/api/v1/otp/send
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{keycloak_token}}
}

body:json {
  {
    "email": "{{email}}",
    "phonenumber": "{{phonenumber}}"
  }
}

script:post-response {
  test('Status 200', () => expect(res.getStatus()).to.equal(200));
}
