meta {
  name: 4B) Finalize IN_PERSON (avec date, sans fichiers)
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/foreigner/register/finalize
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "registration_token": "{{registration_token}}",
    "transaction_id": "{{transaction_id}}",
    "type": "IN_PERSON",
    "level": "ADVANCED",
    "date": "2025-10-01T10:00:00Z",
    "kyc": { "name": "SMITH" }
  }
}

script:post-response {
  test('Status 200', () => expect(res.getStatus()).to.equal(200));
  const json = res.getBody();
  test('User créé', () => expect(json.data).to.have.property('user_id'));
  bru.setVar('user_id', json.data.user_id);
}

settings {
  encodeUrl: true
}
