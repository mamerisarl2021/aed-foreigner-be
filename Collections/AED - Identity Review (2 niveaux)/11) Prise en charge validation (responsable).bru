meta {
  name: 11) Prise en charge validation (responsable)
  type: http
  seq: 11
}

patch {
  url: {{gateway_url}}/api/v1/enrolements/{{demande_id}}/prise-en-charge-validation
  body: none
  auth: bearer
}

auth:bearer {
  token: {{supervisor_token}}
}

script:pre-request {
  if (!bru.getVar('demande_id')) {
    bru.setNextRequest(null);
  }
}

script:post-response {
  test('Status 200', () => expect(res.getStatus()).to.equal(200));
}
