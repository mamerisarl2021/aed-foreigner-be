  auth: bearer
}

auth:bearer {
  token: {{staff_token}}
}

body:json {
  {
    "statut": "REJET_AGENT",
    "motif": ["kyc_incomplete"],
    "commentaire": "Veuillez reprendre le selfie avec bonne luminosité."
  }
}

script:post-response {
  test('Status 200', () => expect(res.getStatus()).to.equal(200));
}
