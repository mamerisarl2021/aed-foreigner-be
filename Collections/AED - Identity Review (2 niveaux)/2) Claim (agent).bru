meta {
  name: 2) Claim (agent)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/management/identity-reviews/{{identity_id}}/claim
  body: none
  auth: bearer
}

auth:bearer {
  token: {{agent_token}}
}

script:pre-request {
  if (!bru.getVar('identity_id')) {
    bru.setNextRequest(null);
  }
}

script:post-response {
  test('200', () => expect(res.getStatus()).to.equal(200));
}

settings {
  encodeUrl: true
}
