meta {
  name: 2) Prise en charge (agent)
  type: http
  seq: 2
}

patch {
  url: {{gateway_url}}/api/v1/enrolements/{{demande_id}}/prise-en-charge
  body: none
  auth: bearer
}

auth:bearer {
  token: {{staff_token}}
}

script:pre-request {
  if (!bru.getVar('demande_id')) {
    bru.setNextRequest(null);
  }
}

script:post-response {
  test('Status 200', () => expect(res.getStatus()).to.equal(200));
}
