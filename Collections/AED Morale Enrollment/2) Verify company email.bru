meta {
  name: 2) Verify company email
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/morale/enrollments/{{morale_enrollment_id}}/verify-email
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{morale_email_token}}"
  }
}

script:post-response {
  test('200', () => expect(res.getStatus()).to.equal(200));
}
