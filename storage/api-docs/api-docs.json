{
    "openapi": "3.0.0",
    "info": {
        "title": "AED Foreigner API",
        "description": "API documentation for AED Foreigner Enrollment",
        "contact": {
            "email": "support@example.com"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "1.0.0"
    },
    "paths": {
        "/api/v1/admin/login": {
            "post": {
                "tags": [
                    "Admin Auth"
                ],
                "summary": "Admin/Agent Login (Step 1: Request OTP)",
                "operationId": "adminLogin",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OTP sent to email"
                    },
                    "403": {
                        "description": "Forbidden (Not an agent)"
                    }
                }
            }
        },
        "/api/v1/agents/{id}": {
            "post": {
                "tags": [
                    "Admin Auth"
                ],
                "summary": "Update Agent Details",
                "operationId": "updateAgent",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "role": {
                                        "type": "string",
                                        "enum": [
                                            "AGENT",
                                            "RESPONSABLE_DE_VALIDATION",
                                            "MANAGER",
                                            "AUDITEUR"
                                        ]
                                    },
                                    "phonenumber": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Agent updated"
                    }
                }
            }
        },
        "/api/v1/admins/logout": {
            "post": {
                "tags": [
                    "Admin Auth"
                ],
                "summary": "Admin Logout",
                "operationId": "adminLogout",
                "responses": {
                    "200": {
                        "description": "Logged out"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/agents/register": {
            "post": {
                "tags": [
                    "Admin Auth"
                ],
                "summary": "Register New Agent",
                "operationId": "registerAgent",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "phonenumber",
                                    "npi",
                                    "email"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "role": {
                                        "type": "string"
                                    },
                                    "phonenumber": {
                                        "type": "string"
                                    },
                                    "npi": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Agent registered"
                    }
                }
            }
        },
        "/api/v1/admins/verify-otp": {
            "post": {
                "tags": [
                    "Admin Auth"
                ],
                "summary": "Admin/Agent Verify OTP (Step 2: Get Token)",
                "operationId": "adminVerifyOtp",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "otp"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "otp": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Token obtained"
                    },
                    "403": {
                        "description": "Forbidden or Invalid OTP"
                    }
                }
            }
        },
        "/api/v1/foreigner/send-otp": {
            "post": {
                "tags": [
                    "Enrollment"
                ],
                "summary": "Send OTP to email or phone",
                "description": "Sends an OTP to the provided email address or phone number for verification. Provide either email or phonenumber.",
                "operationId": "sendForeignerOtp",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "user@example.com"
                                    },
                                    "phonenumber": {
                                        "type": "string",
                                        "example": "+22990123456"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OTP sent successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "OTP envoyé à votre adresse email."
                                        },
                                        "data": {
                                            "properties": {
                                                "email": {
                                                    "type": "string",
                                                    "example": "user@example.com"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/v1/foreigner/verify-otp": {
            "post": {
                "tags": [
                    "Enrollment"
                ],
                "summary": "Verify OTP",
                "description": "Verifies the OTP sent to the email or phone number. Provide either email or phonenumber with the otp.",
                "operationId": "verifyForeignerOtp",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "otp"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "user@example.com"
                                    },
                                    "phonenumber": {
                                        "type": "string",
                                        "example": "+22990123456"
                                    },
                                    "otp": {
                                        "type": "string",
                                        "example": "123456"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OTP verified successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "OTP vérifié."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid OTP"
                    }
                }
            }
        },
        "/api/v1/foreigner/enroll": {
            "post": {
                "tags": [
                    "Enrollment"
                ],
                "summary": "Submit foreigner enrollment request",
                "description": "Submits a complete enrollment request for a physical foreigner. All KYC data, identity documents, and liveness data are provided in a single step. The request is stored for agent review.",
                "operationId": "submitForeignerEnrollment",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "email",
                                    "phonenumber",
                                    "name",
                                    "first_name",
                                    "sexe",
                                    "date_of_birth",
                                    "place_of_birth",
                                    "nationality",
                                    "country_of_residence",
                                    "address",
                                    "document_type",
                                    "document_number",
                                    "selfie",
                                    "recto"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "phonenumber": {
                                        "type": "string"
                                    },
                                    "name": {
                                        "type": "string"
                                    },
                                    "first_name": {
                                        "type": "string"
                                    },
                                    "sexe": {
                                        "type": "string",
                                        "enum": [
                                            "M",
                                            "F"
                                        ]
                                    },
                                    "date_of_birth": {
                                        "type": "string",
                                        "format": "date"
                                    },
                                    "place_of_birth": {
                                        "type": "string"
                                    },
                                    "nationality": {
                                        "type": "string"
                                    },
                                    "country_of_residence": {
                                        "type": "string"
                                    },
                                    "address": {
                                        "type": "string"
                                    },
                                    "document_type": {
                                        "type": "string",
                                        "enum": [
                                            "PASSPORT",
                                            "CNI_ECOWAS"
                                        ]
                                    },
                                    "document_number": {
                                        "type": "string"
                                    },
                                    "selfie": {
                                        "type": "string",
                                        "format": "binary"
                                    },
                                    "recto": {
                                        "type": "string",
                                        "format": "binary"
                                    },
                                    "verso": {
                                        "type": "string",
                                        "format": "binary"
                                    },
                                    "profile": {
                                        "type": "string",
                                        "format": "binary"
                                    },
                                    "liveness": {
                                        "type": "string"
                                    },
                                    "similarity": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Enrollment request submitted successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Demande enregistrée avec succès."
                                        },
                                        "data": {
                                            "properties": {
                                                "enrollment_request_id": {
                                                    "type": "integer"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "OTP not verified"
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "500": {
                        "description": "Internal server error"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Admin Auth",
            "description": "Admin Auth"
        },
        {
            "name": "Enrollment",
            "description": "Enrollment"
        }
    ]
}